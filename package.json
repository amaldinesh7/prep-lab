{
  "name": "prep-lab",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint .",
    "db:generate": "bun run --filter @prep-lab/db generate",
    "db:migrate": "bun run --filter @prep-lab/db migrate",
    "db:seed": "bun run --filter @prep-lab/db seed"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.66.0",
    "typescript": "^5.6.0"
  }
}
